# IntelliEditor — .gitignore

# Fichiers générés par la compilation
build/
bin/
*.o
*.a
*.dll
*.exe
!SciLexer.dll
!Scintilla.dll
!Lexilla.dll

# Modèles LLM (trop gros pour Git)
*.gguf
*.bin
models/
data/models/

# Dictionnaires
data/dicts/

# Configuration locale
*.ini
!config.ini.example

# IDE et outils
.vscode/
.idea/
*.vcxproj
*.sln
*.slnx
.vs/
CMakeCache.txt
CMakeFiles/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporaires et logs
*.tmp
*.log
output.txt
verbose.txt
test_manual.c
test_*_manual.c
